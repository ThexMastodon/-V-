# Base de datos (local: docker compose up -d postgres · prod: Neon)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/aeva
PAYLOAD_SECRET=CAMBIA_ESTE_SECRETO

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (opcional en local: sin estas variables los archivos se guardan en /media)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Resend (opcional en local: sin API key el correo se imprime en consola)
RESEND_API_KEY=
EMAIL_FROM=hola@aeva.dev
LEADS_NOTIFY_TO=equipo@aeva.dev
